  "scene_actions": [
    {
      "key": "get_folder_status",
      "label": {
        "en": "State of a folder",
        "fr": "État d'un dossier",
        "de": "Zustand eines Ordners",
        "es": "Estado de una carpeta"
      },
      "description": {
        "en": "Reads a watched path for the next actions: files, size, latest file, and a ready-made sentence.",
        "fr": "Lit un chemin surveillé pour les actions suivantes : fichiers, taille, dernier fichier, et une phrase toute faite.",
        "de": "Liest einen überwachten Pfad für die nächsten Aktionen: Dateien, Größe, neueste Datei und einen fertigen Satz.",
        "es": "Lee una ruta vigilada para las acciones siguientes: archivos, tamaño, último archivo y una frase lista."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "required": true,
          "label": {
            "en": "Folder",
            "fr": "Dossier",
            "de": "Ordner",
            "es": "Carpeta"
          }
        }
      ],
      "outputs": [
        {
          "key": "accessible",
          "type": "boolean",
          "label": {
            "en": "Accessible",
            "fr": "Accessible",
            "de": "Erreichbar",
            "es": "Accesible"
          }
        },
        {
          "key": "files",
          "type": "number",
          "label": {
            "en": "Files",
            "fr": "Fichiers",
            "de": "Dateien",
            "es": "Archivos"
          }
        },
        {
          "key": "size",
          "type": "string",
          "label": {
            "en": "Total size",
            "fr": "Taille totale",
            "de": "Gesamtgröße",
            "es": "Tamaño total"
          }
        },
        {
          "key": "last_file",
          "type": "string",
          "label": {
            "en": "Latest file",
            "fr": "Dernier fichier",
            "de": "Neueste Datei",
            "es": "Último archivo"
          }
        },
        {
          "key": "last_file_date",
          "type": "string",
