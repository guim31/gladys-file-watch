                "de": "3 Tage",
                "es": "3 días"
              }
            },
            {
              "value": "168",
              "label": {
                "en": "7 days",
                "fr": "7 jours",
                "de": "7 Tage",
                "es": "7 días"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "folder",
          "type": "string",
          "label": {
            "en": "Folder",
            "fr": "Dossier",
            "de": "Ordner",
            "es": "Carpeta"
          }
        },
        {
          "key": "hours",
          "type": "number",
          "label": {
            "en": "Threshold (hours)",
            "fr": "Seuil (heures)",
            "de": "Schwelle (Stunden)",
            "es": "Umbral (horas)"
          }
        },
        {
          "key": "age_hours",
          "type": "number",
          "label": {
            "en": "Hours since the latest file",
