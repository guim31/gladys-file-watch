          "key": "device",
          "type": "multi_select",
          "source": "devices",
          "label": {
            "en": "Folders (empty: any)",
            "fr": "Dossiers (vide : tous)",
            "de": "Ordner (leer: alle)",
            "es": "Carpetas (vacío: todas)"
          }
        },
        {
