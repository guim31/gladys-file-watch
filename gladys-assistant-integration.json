{
  "manifest_version": 1,
  "type": "device",
  "name": "File watch",
  "description": {
    "en": "Watch folders and files: new files, count, size, a backup that no longer arrives.",
    "fr": "Surveillez dossiers et fichiers : nouveaux fichiers, nombre, taille, sauvegarde qui n'arrive plus.",
    "de": "Überwache Ordner und Dateien: neue Dateien, Anzahl, Größe, ein ausbleibendes Backup.",
    "es": "Vigile carpetas y archivos: archivos nuevos, número, tamaño, una copia que ya no llega."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-file-watch:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-file-watch/main/cover.png",
  "categories": ["servers", "services"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Where to put the folders",
        "fr": "Où placer les dossiers",
        "de": "Wohin mit den Ordnern",
        "es": "Dónde colocar las carpetas"
      },
      "description": {
        "en": "Gladys gives the integration a single folder of its host. Put, link or mount (NFS, SMB, bind mount) the folders to watch in its \"watch\" sub-folder, then restart the integration. The guide gives the exact path.",
        "fr": "Gladys ne donne à l'intégration qu'un dossier de son hôte. Placez ou montez (NFS, SMB, montage bind) les dossiers à surveiller dans son sous-dossier « watch », puis redémarrez l'intégration. Le guide donne le chemin exact.",
        "de": "Gladys gibt der Integration nur einen Ordner ihres Hosts. Lege oder hänge (NFS, SMB, Bind-Mount) die zu überwachenden Ordner in dessen Unterordner „watch“ ein und starte die Integration neu. Die Anleitung nennt den genauen Pfad.",
        "es": "Gladys solo da a la integración una carpeta de su host. Coloque o monte (NFS, SMB, montaje bind) las carpetas que vigilar en su subcarpeta «watch» y reinicie la integración. La guía indica la ruta exacta."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-file-watch/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Einrichtungsanleitung",
            "es": "Guía de instalación"
          }
        }
      ]
    },
    {
      "key": "paths",
      "type": "string",
      "label": {
        "en": "Paths to watch",
        "fr": "Chemins à surveiller",
        "de": "Zu überwachende Pfade",
        "es": "Rutas que vigilar"
      },
      "description": {
        "en": "Folders or files under /data/watch, separated by commas. Empty: every folder and file at the top of /data/watch.",
        "fr": "Dossiers ou fichiers sous /data/watch, séparés par des virgules. Vide : chaque dossier et fichier à la racine de /data/watch.",
        "de": "Ordner oder Dateien unter /data/watch, durch Kommas getrennt. Leer: jeder Ordner und jede Datei direkt in /data/watch.",
        "es": "Carpetas o archivos bajo /data/watch, separados por comas. Vacío: cada carpeta y archivo en la raíz de /data/watch."
      },
      "placeholder": {
        "en": "e.g. backups, nas/scans",
        "fr": "ex. sauvegardes, nas/scans",
        "de": "z. B. backups, nas/scans",
        "es": "p. ej. copias, nas/scans"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "filters",
      "type": "section",
      "label": {
        "en": "Filters",
        "fr": "Filtres",
        "de": "Filter",
        "es": "Filtros"
      }
    },
    {
      "key": "include",
      "type": "string",
      "label": {
        "en": "Only these files",
        "fr": "Seulement ces fichiers",
        "de": "Nur diese Dateien",
        "es": "Solo estos archivos"
      },
      "description": {
        "en": "Glob patterns, separated by commas: *.pdf, daily/*.tar.gz. Empty: every file.",
        "fr": "Motifs glob, séparés par des virgules : *.pdf, daily/*.tar.gz. Vide : tous les fichiers.",
        "de": "Glob-Muster, durch Kommas getrennt: *.pdf, daily/*.tar.gz. Leer: alle Dateien.",
        "es": "Patrones glob, separados por comas: *.pdf, daily/*.tar.gz. Vacío: todos los archivos."
      },
      "placeholder": {
        "en": "e.g. *.pdf, *.jpg",
        "fr": "ex. *.pdf, *.jpg",
        "de": "z. B. *.pdf, *.jpg",
        "es": "p. ej. *.pdf, *.jpg"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "exclude",
      "type": "string",
      "label": {
        "en": "Ignore",
        "fr": "Ignorer",
        "de": "Ignorieren",
        "es": "Ignorar"
      },
      "description": {
        "en": "Glob patterns of files and folders to ignore. The default skips hidden, temporary and system files.",
        "fr": "Motifs glob des fichiers et dossiers à ignorer. Par défaut : fichiers cachés, temporaires et système.",
        "de": "Glob-Muster der zu ignorierenden Dateien und Ordner. Standard: versteckte, temporäre und Systemdateien.",
        "es": "Patrones glob de archivos y carpetas que ignorar. Por defecto: archivos ocultos, temporales y de sistema."
      },
      "required": false,
      "default": ".*, *.tmp, *.part, *.partial, *.crdownload, ~$*, Thumbs.db, desktop.ini, @eaDir, #recycle"
    },
    {
      "key": "max_depth",
      "type": "number",
      "label": {
        "en": "Depth",
        "fr": "Profondeur",
        "de": "Tiefe",
        "es": "Profundidad"
      },
      "description": {
        "en": "Levels of sub-folders read: 1 for the files of the folder only.",
        "fr": "Niveaux de sous-dossiers lus : 1 pour les seuls fichiers du dossier.",
        "de": "Gelesene Unterordner-Ebenen: 1 nur für die Dateien des Ordners selbst.",
        "es": "Niveles de subcarpetas leídos: 1 solo para los archivos de la carpeta."
      },
      "required": false,
      "default": 5,
      "min": 1,
      "max": 20
    },
    {
      "key": "options",
      "type": "section",
      "label": {
        "en": "Options",
        "fr": "Options",
        "de": "Optionen",
        "es": "Opciones"
      }
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Scan interval",
        "fr": "Intervalle d'analyse",
        "de": "Scan-Intervall",
        "es": "Intervalo de análisis"
      },
      "description": {
        "en": "How often the folders are scanned (names, sizes and dates only, never the content).",
        "fr": "Fréquence d'analyse des dossiers (noms, tailles et dates seulement, jamais le contenu).",
        "de": "Wie oft die Ordner durchsucht werden (nur Namen, Größen und Daten, nie der Inhalt).",
        "es": "Frecuencia de análisis de las carpetas (solo nombres, tamaños y fechas, nunca el contenido)."
      },
      "required": false,
      "default": "60",
      "options": [
        {
          "value": "30",
          "label": {
            "en": "30 seconds",
            "fr": "30 secondes",
            "de": "30 Sekunden",
            "es": "30 segundos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        },
        {
          "value": "900",
          "label": {
            "en": "15 minutes",
            "fr": "15 minutes",
            "de": "15 Minuten",
            "es": "15 minutos"
          }
        },
        {
          "value": "3600",
          "label": {
            "en": "1 hour",
            "fr": "1 heure",
            "de": "1 Stunde",
            "es": "1 hora"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the names",
        "fr": "Langue des noms",
        "de": "Sprache der Namen",
        "es": "Idioma de los nombres"
      },
      "description": {
        "en": "Language of the feature names (set when a device is added), of the dates, sizes and scene results.",
        "fr": "Langue des noms de fonctionnalités (fixés à l'ajout d'un appareil), des dates, tailles et résultats de scène.",
        "de": "Sprache der Funktionsnamen (beim Hinzufügen eines Geräts festgelegt), der Daten, Größen und Szenenergebnisse.",
        "es": "Idioma de los nombres de funciones (fijados al añadir un dispositivo), de las fechas, tamaños y resultados de escena."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "check_paths",
      "label": {
        "en": "Check the watched folders",
        "fr": "Vérifier les dossiers surveillés",
        "de": "Überwachte Ordner prüfen",
        "es": "Comprobar las carpetas vigiladas"
      },
      "timeout_seconds": 60
    }
  ],
  "scene_triggers": [
    {
      "key": "new_file",
      "label": {
        "en": "New file",
        "fr": "Nouveau fichier",
        "de": "Neue Datei",
        "es": "Archivo nuevo"
      },
      "description": {
        "en": "A file appears in a watched folder (a renamed file is not new). Beyond 5 at once, one event with the count.",
        "fr": "Un fichier apparaît dans un dossier surveillé (un fichier renommé n'est pas nouveau). Au-delà de 5 d'un coup, un seul événement avec le nombre.",
        "de": "Eine Datei erscheint in einem überwachten Ordner (eine umbenannte Datei ist nicht neu). Ab 6 auf einmal ein einziges Ereignis mit der Anzahl.",
        "es": "Aparece un archivo en una carpeta vigilada (un archivo renombrado no es nuevo). Más de 5 a la vez: un solo evento con el número."
      },
      "fields": [
        {
          "key": "device",
          "type": "multi_select",
          "source": "devices",
          "label": {
            "en": "Folders (empty: any)",
            "fr": "Dossiers (vide : tous)",
            "de": "Ordner (leer: alle)",
            "es": "Carpetas (vacío: todas)"
          }
        },
        {
          "key": "extension",
          "type": "string",
          "label": {
            "en": "Extension (empty: any)",
            "fr": "Extension (vide : toutes)",
            "de": "Endung (leer: alle)",
            "es": "Extensión (vacío: todas)"
          },
          "placeholder": {
            "en": "e.g. pdf",
            "fr": "ex. pdf",
            "de": "z. B. pdf",
            "es": "p. ej. pdf"
          }
        }
      ],
      "variables": [
        {
          "key": "folder",
          "type": "string",
          "label": {
            "en": "Folder",
            "fr": "Dossier",
            "de": "Ordner",
            "es": "Carpeta"
          }
        },
        {
          "key": "file",
          "type": "string",
          "label": {
            "en": "File (path in the folder)",
            "fr": "Fichier (chemin dans le dossier)",
            "de": "Datei (Pfad im Ordner)",
            "es": "Archivo (ruta en la carpeta)"
          }
        },
        {
          "key": "extension",
          "type": "string",
          "label": {
            "en": "Extension",
            "fr": "Extension",
            "de": "Endung",
            "es": "Extensión"
          }
        },
        {
          "key": "size",
          "type": "string",
          "label": {
            "en": "Size",
            "fr": "Taille",
            "de": "Größe",
            "es": "Tamaño"
          }
        },
        {
          "key": "count",
          "type": "number",
          "label": {
            "en": "Number of new files",
            "fr": "Nombre de nouveaux fichiers",
            "de": "Anzahl neuer Dateien",
            "es": "Número de archivos nuevos"
          }
        }
      ]
    },
    {
      "key": "folder_stale",
      "label": {
        "en": "Folder not modified for a while",
        "fr": "Dossier non modifié depuis un moment",
        "de": "Ordner länger nicht geändert",
        "es": "Carpeta sin cambios desde hace tiempo"
      },
      "description": {
        "en": "No file arrived for the chosen time: a backup that no longer comes, a camera that stopped recording.",
        "fr": "Aucun fichier arrivé depuis la durée choisie : une sauvegarde qui ne vient plus, une caméra qui n'enregistre plus.",
        "de": "Seit der gewählten Zeit ist keine Datei angekommen: ein ausbleibendes Backup, eine Kamera, die nicht mehr aufnimmt.",
        "es": "Ningún archivo ha llegado durante el tiempo elegido: una copia que ya no llega, una cámara que dejó de grabar."
      },
      "fields": [
        {
          "key": "device",
          "type": "multi_select",
          "source": "devices",
          "label": {
            "en": "Folders (empty: any)",
            "fr": "Dossiers (vide : tous)",
            "de": "Ordner (leer: alle)",
            "es": "Carpetas (vacío: todas)"
          }
        },
        {
          "key": "hours",
          "type": "select",
          "required": true,
          "label": {
            "en": "Not modified for",
            "fr": "Non modifié depuis",
            "de": "Nicht geändert seit",
            "es": "Sin cambios desde hace"
          },
          "options": [
            {
              "value": "1",
              "label": {
                "en": "1 hour",
